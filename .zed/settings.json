{
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "JavaScript": {
      "language_servers": [
        "oxlint",
        "oxfmt",
        "!deno",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSON": {
      "language_servers": [
        "oxfmt",
        "json-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "language_servers": [
        "oxfmt",
        "json-language-server",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TypeScript": {
      "language_servers": [
        "oxlint",
        "oxfmt",
        "!deno",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TSX": {
      "language_servers": [
        "oxlint",
        "oxfmt",
        "!deno",
        "..."
      ],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "YAML": {
      "language_servers": [
        "!yaml-language-server",
        "!eslint",
        "!biome",
        "..."
      ]
    }
  },
  "show_wrap_guides": true,
  "wrap_guides": [
    80
  ],
  "auto_install_extensions": {
    "oxc": true
  }
}
