{
  "name": "@logtape/testing-bun",
  "version": "2.3.0",
  "description": "Bun test runner integration for LogTape failure log reporting",
  "keywords": [
    "logging",
    "log",
    "logger",
    "logtape",
    "testing",
    "test",
    "bun:test"
  ],
  "license": "MIT",
  "author": {
    "name": "Hong Minhee",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "homepage": "https://logtape.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahlia/logtape.git",
    "directory": "packages/testing-bun/"
  },
  "bugs": {
    "url": "https://github.com/dahlia/logtape/issues"
  },
  "funding": [
    "https://github.com/sponsors/dahlia"
  ],
  "type": "module",
  "module": "./dist/mod.js",
  "main": "./dist/mod.cjs",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/mod.d.ts",
        "require": "./dist/mod.d.cts"
      },
      "import": "./dist/mod.js",
      "require": "./dist/mod.cjs"
    },
    "./autoload": {
      "types": {
        "import": "./dist/autoload.d.ts",
        "require": "./dist/autoload.d.cts"
      },
      "import": "./dist/autoload.js",
      "require": "./dist/autoload.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/autoload.js",
    "./dist/autoload.cjs"
  ],
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@logtape/testing": "workspace:^"
  },
  "peerDependencies": {
    "@logtape/logtape": "workspace:^"
  },
  "devDependencies": {
    "@logtape/logtape": "workspace:^",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "prepublish": "tsdown",
    "test": "tsdown && node --experimental-transform-types --test",
    "test:bun": "tsdown && bun test",
    "test:deno": "deno test --allow-read --allow-write --allow-env --allow-run=bun",
    "test-all": "tsdown && node --experimental-transform-types --test && bun test && deno test --allow-read --allow-write --allow-env --allow-run=bun"
  }
}
