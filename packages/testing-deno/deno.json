{
  "name": "@logtape/testing-deno",
  "version": "2.3.7",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./autoload": "./src/autoload.ts"
  },
  "exclude": [
    "coverage/",
    "npm/",
    "dist/"
