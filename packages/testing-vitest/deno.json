{
  "name": "@logtape/testing-vitest",
  "version": "2.3.5",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./autoload": "./src/autoload.ts"
  },
  "exclude": [
    ".tmp-test-*/",
    "coverage/",
    "npm/",
    "dist/"
  ],
  "tasks": {
    "build": "pnpm build",
    "test": "deno test --allow-read --allow-write --allow-env --allow-run=pnpm",
    "test:node": {
      "dependencies": [
        "build"
      ],
      "command": "node --experimental-transform-types --test"
    },
    "test:bun": {
      "dependencies": [
        "build"
      ],
      "command": "bun test"
    },
    "test-all": {
      "dependencies": [
        "test",
        "test:node",
        "test:bun"
      ]
    }
  }
}
