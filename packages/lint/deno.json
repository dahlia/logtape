{
  "name": "@logtape/lint",
  "version": "2.4.0",
  "license": "MIT",
  "imports": {
    "@typescript-eslint/parser": "npm:@typescript-eslint/parser@^8.67.0",
    "eslint": "npm:eslint@^9.0.0",
    "typescript": "npm:typescript@^5.8.3"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./eslint": "./src/eslint/plugin.ts",
    "./deno": "./src/deno/plugin.ts",
    "./deno/strict": "./src/deno/strict-plugin.ts"
  },
  "tasks": {
    "build": "pnpm build",
    "test": "deno test --allow-run --allow-write --allow-read --allow-env",
    "test:node": {
      "dependencies": [
        "build"
      ],
      "command": "node --experimental-transform-types --test"
    },
    "test:bun": {
      "dependencies": [
        "build"
      ],
      "command": "bun test"
    },
    "test-all": {
      "dependencies": [
        "test",
        "test:node",
        "test:bun"
      ]
    }
  }
}
